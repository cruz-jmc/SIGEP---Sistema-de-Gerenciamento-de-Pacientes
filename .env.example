# Conexao PostgreSQL - Supabase
DB_URL=jdbc:postgresql://HOST_DO_SUPABASE:5432/postgres?sslmode=require
DB_USERNAME=USUARIO_AUTORIZADO
DB_PASSWORD=SENHA_RECEBIDA_POR_CANAL_SEGURO

# Lembrando que esse é um exemplo e vcs devem preencher com as suas credenciais. Inclisive a porta 5432 é só um exemplo na url.
# use esse comando no terminal na raíz do projeto: cp .env.example .env